# ========================================
# SecureVault Environment Variables
# ========================================
#
# This file documents all environment variables required by SecureVault.
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Never commit .env files to version control!
# Add .env to your .gitignore file.
#

# ========================================
# Database Configuration
# ========================================

# PostgreSQL database connection URL
# Format: jdbc:postgresql://<host>:<port>/<database>
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/securevault

# PostgreSQL username
SPRING_DATASOURCE_USERNAME=postgres

# PostgreSQL password
# IMPORTANT: Use a strong password in production!
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# ========================================
# Security Configuration
# ========================================

# JWT Secret Key (Base64 encoded)
# IMPORTANT: Generate a unique, strong key for production!
# To generate: echo -n "your-secret-key-32-bytes-long" | base64
# Or use: openssl rand -base64 32
JWT_SECRET_KEY=YXNkZmFzZGZhc2RmYXNkZmFzZGZhc2RmYXNkZmFzZGZhc2RmYXNkZmFzZGZhc2RmYXNkZg==

# JWT Expiration Time in milliseconds
# Default: 86400000 (24 hours)
# 1 hour = 3600000
# 24 hours = 86400000
# 7 days = 604800000
JWT_EXPIRATION_TIME=86400000

# AES Encryption Key (Base64 encoded 256-bit key)
# IMPORTANT: Generate a unique, strong key for production!
# To generate: openssl rand -base64 32
# This key encrypts all passwords stored in the database
AES_ENCRYPTION_KEY=YXNkZmFzZGZhc2RmYXNkZmFzZGZhc2Rm

# ========================================
# Redis Configuration
# ========================================

# Redis host address
SPRING_REDIS_HOST=localhost

# Redis port
SPRING_REDIS_PORT=6379

# Redis database number (0-15)
SPRING_REDIS_DATABASE=0

# Redis password (leave empty if no password)
SPRING_REDIS_PASSWORD=

# Redis connection timeout in milliseconds
SPRING_REDIS_TIMEOUT=5000

# ========================================
# Server Configuration
# ========================================

# Application server port
SERVER_PORT=8080

# ========================================
# How to Use These Variables
# ========================================
#
# Option 1: Using .env file (Development)
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. Use a tool like docker-compose or direnv to load variables
#
# Option 2: Export in Shell (Linux/Mac)
# export JWT_SECRET_KEY="your_secret_key"
# export AES_ENCRYPTION_KEY="your_encryption_key"
# mvn spring-boot:run
#
# Option 3: Command Line (Windows)
# set JWT_SECRET_KEY=your_secret_key
# set AES_ENCRYPTION_KEY=your_encryption_key
# mvn spring-boot:run
#
# Option 4: IntelliJ IDEA
# Run → Edit Configurations → Environment Variables
# Add each variable with its value
#
# Option 5: Docker Compose
# Add to docker-compose.yml under environment: section
#
# Option 6: Production (Cloud Platforms)
# - AWS: Use AWS Secrets Manager or Parameter Store
# - Azure: Use Azure Key Vault
# - Heroku: Use Config Vars
# - Kubernetes: Use Secrets
#
# ========================================
# Security Best Practices
# ========================================
#
# 1. NEVER commit .env files to Git
# 2. Use different keys for dev/staging/production
# 3. Rotate keys regularly (every 90 days minimum)
# 4. Use cloud secret managers in production
# 5. Use strong, randomly generated keys
# 6. Limit access to environment variables
# 7. Audit who has access to secrets
#
