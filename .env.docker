# ============================================
# Docker Environment Variables Template
# ============================================
# Copy this file to .env and configure your values
# These variables are used by docker-compose.yml
# ============================================

# ============================================
# Database Configuration
# ============================================
DB_PASSWORD=your_secure_postgres_password

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=your_secure_redis_password

# ============================================
# Security Configuration
# ============================================
# Generate a new JWT secret: echo -n "your-secret-key-32-bytes-long" | base64
JWT_SECRET_KEY=YXNkZmFzZGZhc2RmYXNkZmFzZGZhc2RmYXNkZmFzZGZhc2RmYXNkZmFzZGZhc2RmYXNkZg==

# JWT token expiration time in milliseconds (24 hours = 86400000)
JWT_EXPIRATION_TIME=86400000

# Generate a new AES key: openssl rand -base64 32
AES_ENCRYPTION_KEY=YXNkZmFzZGZhc2RmYXNkZmFzZGZhc2Rm

# ============================================
# Application Configuration
# ============================================
SPRING_PROFILE=prod
LOG_LEVEL=INFO
SPRING_LOG_LEVEL=WARN
SHOW_SQL=false
